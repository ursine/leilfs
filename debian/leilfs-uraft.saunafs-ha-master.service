[Unit]
Conflicts=saunafs-master.service
Description=LeilFS uraft master server daemon
Documentation=man:leil-master
After=network.target
Wants=network-online.target

[Service]
Type=notify
TimeoutSec=0
ExecStart=/usr/sbin/leil-master -d -o ha-cluster-managed -o initial-personality=shadow start
ExecReload=/bin/kill -HUP $MAINPID
Restart=no
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
